# Porta da API
PORT=3001
# Ambiente: development | production
NODE_ENV=development
# Origem permitida do frontend (usada na proteção CSRF e CORS)
WEB_ORIGIN=http://localhost:5173
# Caminho do banco SQLite (use um volume persistente em produção)
DATABASE_PATH=./data/emiliia.db
# Chave de criptografia (32 bytes em hex) para segredos MFA e registros clínicos.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# Duração da sessão em horas
SESSION_HOURS=8
# Senhas iniciais usadas APENAS pelo seed de desenvolvimento
SEED_PASSWORD_EMILIA=
SEED_PASSWORD_LIGIA=

# ---- Integrações Google (Etapa 4) ----
# Crie um cliente OAuth 2.0 (tipo "Aplicativo da Web") no Google Cloud Console,
# habilite as APIs Google Sheets, Google Calendar e Google Drive, e cadastre a
# URL de redirecionamento abaixo. As credenciais ficam apenas no servidor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública da API usada no redirecionamento OAuth (sem barra final)
API_PUBLIC_URL=http://localhost:3001
# Fuso horário usado nos eventos da agenda
TIMEZONE=America/Sao_Paulo

# ---- WhatsApp Business (Etapa 5) ----
# Cloud API da Meta: token permanente do sistema e ID do número de telefone.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token de verificação do webhook (defina um valor aleatório)
WHATSAPP_VERIFY_TOKEN=

{
  "name": "@emiliia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && cp src/db/schema.sql dist/db/",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:seed": "tsx src/db/seed.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.5.0",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "multer": "^2.5.0",
    "otplib": "12.0.1",
    "pdfkit": "^0.15.1",
    "qrcode": "1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.11",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "22.9.0",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "1.5.5",
    "tsx": "^4.23.15",
    "typescript": "5.6.3"
  }
}
